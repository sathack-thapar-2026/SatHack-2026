# PayZorr — copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored; never commit real keys.

# --- Payment gateway (sandbox credentials from your payment provider's developer dashboard) ---
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# Public URL of this app (used for checkout return links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Gemini (AI milestone audits and invoices) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Required: the API verifies sessions and writes with this key. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Optional one-click demo account on the sign-in page (leave empty to hide the demo section) ---
# These are bundled into the browser JavaScript, so use a throwaway account with no real data.
NEXT_PUBLIC_DEMO_NAME=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
